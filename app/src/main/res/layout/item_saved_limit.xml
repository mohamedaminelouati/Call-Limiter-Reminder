<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_saved_limit"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/contact_info_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/contact_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="John Doe" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/contact_number_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="4dp"
                tools:text="+123456789" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/remaining_time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:layout_marginTop="4dp"
                tools:text="0 hrs 15 mins 00 seconds" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_contact"
            style="?attr/materialIconButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/edit_24px"
            app:iconTint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@string/edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_contact"
            style="?attr/materialIconButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/delete_24px"
            app:iconTint="?attr/colorError"
            android:contentDescription="@string/delete" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
